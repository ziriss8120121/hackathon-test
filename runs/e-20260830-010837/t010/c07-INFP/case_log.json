        "poll_position": 6,
        "player_id": "p1",
        "attempts": 1,
        "wait_seconds": 7.275,
        "speech_id": "e-20260830-010837-t010-c07-s009",
        "spoke": true,
        "skipped": false,
        "speech_text": "P5さん、趣味や特技についてお伺いしたいのですが、何か共通の話題が見つかれば、少しでも距離を縮められるかもしれません。例えば、最近興味があることや、好きな食べ物など、どんなことでも構いません。",
        "memo": "P5さんのことをもう少し知るために、共通の話題を探ることを試みる。",
        "chars": 96,
        "truncated": false,
        "parse_failed": false
      },
