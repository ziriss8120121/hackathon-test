        "attempts": 1,
        "wait_seconds": 3.002,
        "speech_id": "e-20260830-010837-t008-c10-s006",
        "spoke": true,
        "skipped": false,
        "speech_text": "皆さん、初めまして！怪盗として、まずは皆さんの動向を観察していきたいと思います。特に、占い師さんや人狼さんの行動に注目していきたいですね。まずは、皆さんの最初の印象を共有させてください。",
        "memo": "状況を把握するため、まずは皆の動向を観察したい。",
        "chars": 93,
        "truncated": false,
        "parse_failed": false
      },
      {
        "order": 7,
